# Copy to .env.local for local development. The server checks these on startup and
# refuses to run, listing what's wrong, if a required value is missing or malformed.

# --- Required ---

# Postgres connection string. On Vercel, the Neon integration sets this for you.
DATABASE_URL=postgres://user:password@localhost:5432/cswitch_waitlist

# Password for /admin/login. At least 12 characters.
ADMIN_PASSWORD=

# Signs the admin login cookie. At least 32 characters: openssl rand -base64 32
SESSION_SECRET=

# --- Recommended ---

# Public URL used in referral links, e.g. https://cswitch.ng (no trailing slash).
# Falls back to the request's host when unset.
SITE_URL=

# --- Confirmation email (Resend). Set both to turn it on; leave both empty to turn it off. ---

RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. CSwitch <hello@cswitch.ng>
EMAIL_FROM=
# Optional: where replies to the confirmation email go.
EMAIL_REPLY_TO=
